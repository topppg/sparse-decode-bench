 tools/sparse-tail/sparse-tail.cpp | 455 ++++++++++++++++--------------
 1 file changed, 247 insertions(+), 208 deletions(-)

diff --git a/tools/sparse-tail/sparse-tail.cpp b/tools/sparse-tail/sparse-tail.cpp
index 58e656148..7a312dd33 100644
--- a/tools/sparse-tail/sparse-tail.cpp
+++ b/tools/sparse-tail/sparse-tail.cpp
@@ -1,6 +1,8 @@
 // sparse-tail: dense prefill of T - n_tail tokens, then n_tail teacher-forced single-token decode steps per config,
 // KL(dense || config) of the next-token distribution per row. Configs set LLAMA_SPARSE_DECODE / LLAMA_SPARSE_DECODE_SCORE,
 // and score:budget:f0|f1|f2|f3 also LLAMA_SPARSE_DECODE_FUSED (without the suffix the variable is left as it is).
+// A config pf:F[:W] sets LLAMA_SPARSE_PREFILL=F (and LLAMA_SPARSE_PREFILL_WINDOW=W) during the prefill, with dense decode;
+// pf:F[:W]+score:budget[:fN] combines both. Configs with the same prefill share one prefill.
 
 #include "llama.h"
 #include "ggml-backend.h"
@@ -21,8 +23,36 @@ struct tail_config {
     std::string score;
     int         budget = 0;
     std::string fused;
+    std::string pf;        // LLAMA_SPARSE_PREFILL, empty for a dense prefill
+    std::string pf_window; // LLAMA_SPARSE_PREFILL_WINDOW, empty for the default
 };
 
+static void set_prefill_env(const std::string & pf, const std::string & window) {
+    if (pf.empty()) {
+        unsetenv("LLAMA_SPARSE_PREFILL");
+        unsetenv("LLAMA_SPARSE_PREFILL_WINDOW");
+        return;
+    }
+    setenv("LLAMA_SPARSE_PREFILL", pf.c_str(), 1);
+    if (window.empty()) {
+        unsetenv("LLAMA_SPARSE_PREFILL_WINDOW");
+    } else {
+        setenv("LLAMA_SPARSE_PREFILL_WINDOW", window.c_str(), 1);
+    }
+}
+
+static void set_decode_env(const tail_config & c) {
+    if (c.budget > 0) {
+        setenv("LLAMA_SPARSE_DECODE", std::to_string(c.budget).c_str(), 1);
+        setenv("LLAMA_SPARSE_DECODE_SCORE", c.score.c_str(), 1);
+        if (!c.fused.empty()) {
+            setenv("LLAMA_SPARSE_DECODE_FUSED", c.fused.c_str(), 1);
+        }
+    } else {
+        unsetenv("LLAMA_SPARSE_DECODE");
+    }
+}
