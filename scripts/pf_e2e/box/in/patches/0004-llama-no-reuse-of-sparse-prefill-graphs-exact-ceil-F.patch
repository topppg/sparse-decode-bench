From 8d5c0ecf8f5a1e7e15d71c5f830a964377a0aad8 Mon Sep 17 00:00:00 2001
From: topppg <giorgio.srn@gmail.com>
Date: Tue, 17 Nov 2026 17:46:47 +0100
Subject: [PATCH 4/7] llama : no reuse of sparse prefill graphs, exact
 ceil(F*n) in double, sparse-tail : pf:F:R row selectors without W, count
 reused prefill graphs

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/llama-graph.cpp               | 20 ++++++++++++--------
 src/llama-graph.h                 |  3 ++-
 tools/sparse-tail/sparse-tail.cpp | 26 ++++++++++++++++++--------
 3 files changed, 32 insertions(+), 17 deletions(-)

diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index bc07e5cae..3176d3ad1 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -658,9 +658,9 @@ void llm_graph_input_attn_no_cache::set_input(const llama_ubatch * ubatch) {
 //                                       (hi may be empty: no upper limit). The page picks of a block still use all its rows.
 // Needs flash attention, one sequence whose cell index equals its position, no ALiBi. Composes with LLAMA_SPARSE_DECODE,
 // which then selects from the K written by the sparse prefill.
-static float llama_sparse_prefill_frac() {
+static double llama_sparse_prefill_frac() {
     const char * e = getenv("LLAMA_SPARSE_PREFILL");
-    const float f = e ? (float) atof(e) : 0.0f;
+    const double f = e ? atof(e) : 0.0;
     GGML_ASSERT(f >= 0.0f && f <= 1.0f && "LLAMA_SPARSE_PREFILL must be in [0, 1]");
     return f;
 }
@@ -701,7 +701,7 @@ struct llama_sparse_prefill_plan {
     std::vector<int64_t> k;
 };
 
-static llama_sparse_prefill_plan llama_sparse_prefill_make_plan(int64_t c0, int64_t n_tokens, float frac, int64_t window) {
+static llama_sparse_prefill_plan llama_sparse_prefill_make_plan(int64_t c0, int64_t n_tokens, double frac, int64_t window) {
     llama_sparse_prefill_plan pl;
     pl.n_qblk = (n_tokens + 63)/64;
     int64_t k_min = INT64_MAX;
@@ -709,7 +709,8 @@ static llama_sparse_prefill_plan llama_sparse_prefill_make_plan(int64_t c0, int6
         const int64_t ws     = c0 + 64*b - window;
         const int64_t wsp    = ws < 64 ? 1 : ws/64;
         const int64_t n_elig = wsp - 1;
-        const int64_t k      = std::min<int64_t>(n_elig, (int64_t) std::ceil((double) frac*n_elig - 1e-6));
+        // ceil(F*n), at least one page; the 1e-9 only absorbs double rounding of an exact product (0.1*30)
+        const int64_t k      = n_elig > 0 ? std::clamp<int64_t>((int64_t) std::ceil(frac*n_elig - 1e-9), 1, n_elig) : 0;
         pl.wsp.push_back(wsp);
         pl.k.push_back(k);
         pl.n_top = std::max(pl.n_top, k);
@@ -911,10 +912,10 @@ void llm_sparse_pages::set_input(const ggml_tensor * mask, const llama_ubatch *
 }
 
 bool llm_sparse_pages::can_reuse() const {
-    // a sparse prefill graph depends on the positions of its ubatch
+    // a multi-token graph built with the sparse prefill enabled depends on the positions of its ubatch, even when it fell back
+    // to dense attention (nothing selectable yet, rows outside LLAMA_SPARSE_PREFILL_ROWS): never reused
     return sp_budget == llama_sparse_pages_budget() && sp_score == llama_sparse_pages_score() && sp_fused == llama_sparse_pages_fused() &&
-        pf_frac == llama_sparse_prefill_frac() && pf_window == llama_sparse_prefill_window() && !pf_tmask &&
-        (pf_frac == 0.0f || !getenv("LLAMA_SPARSE_PREFILL_ROWS"));
+        pf_frac == llama_sparse_prefill_frac() && pf_window == llama_sparse_prefill_window() && !pf_seen;
 }
 
 void llm_graph_input_attn_kv::set_input(const llama_ubatch * ubatch) {
@@ -3860,7 +3861,10 @@ ggml_tensor * llm_graph_context::build_sparse_prefill(
               float   kq_scale,
                 int   il) const {
     const int64_t nt = q->ne[2];
-    if (sp->pf_frac <= 0.0f || !ps || nt <= 1 || hparams.is_swa(il) || kv_rows || kq_b || v_mla || !cparams.flash_attn || cparams.training ||
+    if (sp->pf_frac > 0.0 && nt > 1) {
+        sp->pf_seen = true;
+    }
+    if (sp->pf_frac <= 0.0 || !ps || nt <= 1 || hparams.is_swa(il) || kv_rows || kq_b || v_mla || !cparams.flash_attn || cparams.training ||
             hparams.use_alibi || hparams.f_max_alibi_bias != 0.0f || (sinks && (!ggml_is_vector(sinks) || sinks->type != GGML_TYPE_F32)) ||
             kq_mask->type != GGML_TYPE_F16 || kq_mask->ne[1] != nt || kq_mask->ne[2] != 1 || kq_mask->ne[3] != 1 ||
             k->ne[3] != 1 || k->ne[2] % 64 != 0 || k->ne[2] < llama_sparse_prefill_min_ctx() || v->nb[1] > v->nb[2] ||
diff --git a/src/llama-graph.h b/src/llama-graph.h
index 93f2e7550..bd87630fb 100644
--- a/src/llama-graph.h
+++ b/src/llama-graph.h
@@ -347,7 +347,8 @@ struct llm_sparse_pages {
     ggml_tensor * pf_bias      = nullptr; // F32 [n_page + n_dummy, n_qblk] eligibility and dummy picks, added to the block scores
     ggml_tensor * pf_blocks    = nullptr; // I32 [64, n_page] the cells of each page
     ggml_tensor * pf_extra     = nullptr; // I32 [n_extra, n_tokens] page 0 and the window cells of each row, -1 padded
-    float         pf_frac      = 0.0f;
+    double        pf_frac      = 0.0;
+    bool          pf_seen      = false; // a multi-token graph was built with the sparse prefill enabled
     int64_t       pf_window    = 0;
     int64_t       pf_top       = 0;  // picks per row, dummies included
     int64_t       pf_dummy     = 0;
diff --git a/tools/sparse-tail/sparse-tail.cpp b/tools/sparse-tail/sparse-tail.cpp
index 6f926eb35..7d3c16fc9 100644
--- a/tools/sparse-tail/sparse-tail.cpp
+++ b/tools/sparse-tail/sparse-tail.cpp
@@ -3,7 +3,7 @@
 // and score:budget:f0|f1|f2|f3 also LLAMA_SPARSE_DECODE_FUSED (without the suffix the variable is left as it is).
 // A config pf:F[:W] sets LLAMA_SPARSE_PREFILL=F (and LLAMA_SPARSE_PREFILL_WINDOW=W) during the prefill, with dense decode;
 // pf:F[:W]+score:budget[:fN] combines both. Configs with the same prefill share one prefill.
-// pf:F:W:R limits the sparse query rows of a prefill of n tokens (LLAMA_SPARSE_PREFILL_ROWS): R = d<N> keeps the last N
+// pf:F[:W][:R] limits the sparse query rows of a prefill of n tokens (LLAMA_SPARSE_PREFILL_ROWS): R = d<N> keeps the last N
 // rows dense, s<N> makes only the last N rows sparse, du keeps the last ubatch dense.
 
 #include "llama.h"
@@ -42,6 +42,10 @@ static std::string prefill_rows(const std::string & r, int n, int n_ubatch) {
     return r[0] == 'd' ? "0:" + std::to_string(m) : std::to_string(m) + ":";
 }
 
+static bool is_rows_selector(const std::string & r) {
+    return r == "du" || (r.size() > 1 && (r[0] == 'd' || r[0] == 's') && strspn(r.c_str() + 1, "0123456789") == r.size() - 1);
+}
+
 static void set_prefill_env(const std::string & pf, const std::string & window) {
     if (pf.empty()) {
         unsetenv("LLAMA_SPARSE_PREFILL");
@@ -201,15 +205,15 @@ int main(int argc, char ** argv) {
                 const double f = std::stod(p[1]);
                 if (!(f > 0.0 && f <= 1.0) || p.size() > 4) { fprintf(stderr, "bad config %s\n", c.c_str()); return 1; }
                 tc.pf = p[1];
-                if (p.size() > 2) {
-                    tc.pf_window = p[2];
-                }
-                if (p.size() > 3) {
-                    const std::string & r = p[3];
-                    if (r != "du" && !(r.size() > 1 && (r[0] == 'd' || r[0] == 's') && strspn(r.c_str() + 1, "0123456789") == r.size() - 1)) {
+                // pf:F, pf:F:W, pf:F:R or pf:F:W:R with W a number of cells and R a row selector
+                for (size_t j = 2; j < p.size(); ++j) {
+                    if (j == p.size() - 1 && is_rows_selector(p[j])) {
+                        tc.pf_rows = p[j];
+                    } else if (j == 2 && !p[j].empty() && strspn(p[j].c_str(), "0123456789") == p[j].size()) {
+                        tc.pf_window = p[j];
+                    } else {
                         fprintf(stderr, "bad config %s\n", c.c_str()); return 1;
                     }
-                    tc.pf_rows = r;
                 }
                 continue;
             }
@@ -380,6 +384,7 @@ int main(int argc, char ** argv) {
         ds.with_k = false;
         ds.prefix = "prefill_" + c0.name;
         std::replace(ds.prefix.begin(), ds.prefix.end(), ':', '-');
+        const int32_t n_reused0 = llama_perf_context(ctx).n_reused;
         for (int i = 0; i < n; i += cp.n_batch) {
             const int m = std::min<int>(cp.n_batch, n - i);
             llama_batch_ext_clear(batch);
@@ -391,6 +396,10 @@ int main(int argc, char ** argv) {
             if (llama_process(ctx, LLAMA_PROCESS_TYPE_DECODE, batch)) { fprintf(stderr, "prefill failed\n"); exit(1); }
         }
         ds.active = false;
+        const int32_t n_reused = llama_perf_context(ctx).n_reused - n_reused0;
+        if (n_reused > 0) {
+            fprintf(stderr, "prefill %s: %d graphs reused\n", c0.name.c_str(), n_reused);
+        }
         set_prefill_env("", "");
         unsetenv("LLAMA_SPARSE_PREFILL_ROWS");
         snapshot();
@@ -590,6 +599,7 @@ int main(int argc, char ** argv) {
         }
     }
 
+    fprintf(stderr, "graphs reused in total: %d\n", llama_perf_context(ctx).n_reused);
     if (fref) fclose(fref);
     for (auto & [c, f] : fsave) fclose(f);
     llama_batch_ext_free(batch);
-- 
