# PF-E2E RULER arm, registered unit orders (unit = q38:<pass>.<task>; pass 1 = prompts 0-9 on box B, pass 2 = prompts
# 10-19 on box C; PF-NT's order: qa_1 and vt first for gate F, task 0 third for gate D). Cap 54000 s per box from launch
# (setup included), pull window 1200 s.
#   source /root/pfe2/in/units.env; UNITS="$UNITS_B" setsid nohup bash /root/pfe2/in/e2e_wrap.sh /root/pfe2/in/run_pfe_ruler.sh 54000 1200 > /root/pfe2_wrap.log 2>&1 < /dev/null &
#   source /root/pfe2/in/units.env; UNITS="$UNITS_C" setsid nohup bash /root/pfe2/in/e2e_wrap.sh /root/pfe2/in/run_pfe_ruler.sh 54000 1200 > /root/pfe2_wrap.log 2>&1 < /dev/null &
# Speed arms (run_pfe_speed.sh, matrix pfe_matrix.tsv): box A (RTX 5090) cap 18000 s, box D (RTX 4090) cap 10800 s, pull window 1200 s:
#   ARM=A setsid nohup bash /root/pfe2/in/e2e_wrap.sh /root/pfe2/in/run_pfe_speed.sh 18000 1200 > /root/pfe2_wrap.log 2>&1 < /dev/null &
#   ARM=D setsid nohup bash /root/pfe2/in/e2e_wrap.sh /root/pfe2/in/run_pfe_speed.sh 10800 1200 > /root/pfe2_wrap.log 2>&1 < /dev/null &
UNITS_B="q38:1.11 q38:1.8 q38:1.0 q38:1.1 q38:1.2 q38:1.3 q38:1.4 q38:1.5 q38:1.6 q38:1.7 q38:1.9 q38:1.10 q38:1.12"
UNITS_C="q38:2.11 q38:2.8 q38:2.0 q38:2.1 q38:2.2 q38:2.3 q38:2.4 q38:2.5 q38:2.6 q38:2.7 q38:2.9 q38:2.10 q38:2.12"
