+    // the 64-cell pages this group can read, for the conversion of only those K/V cells (two bitmap words per page)
+    if (page_flags) {
+        const int n_page_flags = (n_kv + 63)/64;
+        for (int w = tid; w < n_words; w += blockDim.x) {
+            if (bitmap[w]) {
